# ─────────────────────────────────────────────────────────────
# 운세 노트 환경변수 예시
# - 로컬: `npm run setup` 이 이 파일을 .env.local 로 복사하고 암호화 키를 만든다.
# - Vercel: Project Settings → Environment Variables 에 같은 이름으로 넣는다.
# NEXT_PUBLIC_ 이 붙은 값만 브라우저에 노출된다. 나머지는 서버 전용 비밀값이다.
# ─────────────────────────────────────────────────────────────

# ── 로컬 체험 모드 ──
# true: Supabase 없이 내장 Postgres(PGlite, ./.local-db)와 간이 로그인으로 실행 (개발용, 프로덕션에서는 거부됨)
LOCAL_DEV_MODE=false

# ── 회원가입 ──
# open: 누구나 가입(이메일·비밀번호·닉네임) / invite: 초대 코드 필요 / closed: 가입 중지
SIGNUP_MODE=open
# 관리자 권한을 줄 이메일 (쉼표 구분). 가입하거나 다음 로그인 때 관리자가 된다
ADMIN_EMAILS=

# ── Supabase ──
# Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key(sb_secret_...) 또는 legacy service_role key. 회원가입 시 계정 생성·삭제에만 사용. 절대 NEXT_PUBLIC_ 로 두지 말 것
SUPABASE_SECRET_KEY=
# Project Settings → Database → Connection string → Transaction pooler (포트 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── 출생 정보·운세 내용 암호화 키 (base64 32바이트) ──
# 분실하면 기존 데이터를 복호화할 수 없다. Vercel 환경변수와 별도 비밀 저장소에 백업할 것
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# ── AI ──
# mock: 키 없이 모의 응답 / anthropic: Claude API 사용
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high
AI_EFFORT=medium
AI_TIMEOUT_MS=110000
AI_MAX_RETRIES=1

# ── 사주 계산 외부 엔진 (점봄 만세력 API, 무료·키 없음·CC BY 4.0) ──
JEOMBOM_ENABLED=true
JEOMBOM_BASE_URL=https://jeombom.kr/api/manse
ENGINE_TIMEOUT_MS=8000
ENGINE_MAX_RETRIES=1

# ── 호출 제한과 예산 ──
LIMIT_AI_PER_USER_PER_DAY=20
LIMIT_AI_PER_USER_PER_MINUTE=3
LIMIT_CALC_PER_USER_PER_DAY=60
# 서비스 전체 월 AI 예산 (USD, 추정 비용 기준)
BUDGET_MONTHLY_USD=20

# ── 보존·정기 작업 ──
USAGE_LOG_RETENTION_DAYS=180
# Vercel Cron이 /api/cron/purge 호출 시 사용 (16자 이상 무작위 문자열)
CRON_SECRET=
